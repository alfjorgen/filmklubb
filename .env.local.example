# --- Fjaler Filmklubb environment variables ---
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`. These are server-side only — none are exposed to the browser.

# Checkin.no API token. Used to fetch past/inactive screenings (the "history").
# Active/upcoming events are public and work without it, but history needs it.
# Sent as:  Authorization: Bearer <CHECKIN_API_TOKEN>
CHECKIN_API_TOKEN=

# Secret used to authorize the on-demand revalidation endpoint:
#   POST /api/revalidate?secret=<REVALIDATE_SECRET>
# Pick a long random string (e.g. `openssl rand -hex 32`).
REVALIDATE_SECRET=
